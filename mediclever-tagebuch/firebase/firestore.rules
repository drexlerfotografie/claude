rules_version = '2';

// MediClever Tagebuch – Firestore-Regeln
//
// Aufbau der Daten:
//   users/{uid}                    kleines Profildokument
//   users/{uid}/settings/main      Einstellungen (UserSettings)
//   users/{uid}/{sammlung}/{id}    Tagebuchdaten, siehe Model.kt im Modul core
//
// Grundsätze:
//   - Jede Person erreicht nur ihren eigenen Zweig (request.auth.uid == uid).
//   - Anonyme Anmeldung zählt nicht als angemeldet.
//   - Alles, was hier nicht ausdrücklich erlaubt ist, ist verboten. Es gibt
//     keine Regel für Sammlungsgruppen und keine für unbekannte Sammlungen.
//   - Bei jedem Schreiben wird das vollständige Dokument geprüft, das danach
//     in der Datenbank stünde (request.resource.data), auch bei Teil-Updates.
//   - syncedAt muss der Server-Zeitstempel dieses Schreibvorgangs sein.
//
// Grenzen der Regelsprache, die man kennen muss:
//   Es gibt keine Schleifen, und je Anfrage werden höchstens 1000 Ausdrücke
//   ausgewertet. Listen aus Kennungen (tagIds, assetIds) lassen sich trotzdem
//   vollständig prüfen, siehe isIdList. Für Listen aus Maps (Scale.points,
//   Entry.scaleValues) reicht das Budget nicht: Schon zehn einzeln geprüfte
//   Elemente sprengen es (im Emulator gemessen). Dort wird deshalb nur
//   geprüft, dass es eine Liste mit begrenzter Länge ist. Was in den Maps
//   steht, müssen App und Website beim Lesen selbst vorsichtig auswerten.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Anmeldung ----------

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ---------- Bausteine für Felder ----------

    function incoming() {
      return request.resource.data;
    }

    function hasExactly(d, required, optional) {
      return d.keys().hasAll(required)
        && d.keys().hasOnly(required.concat(optional));
    }

    function isText(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    function isInt(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    // Verweis auf ein anderes Dokument. Zusammengesetzte Kennungen
    // (goal_checks) sind länger, deshalb 150 statt 36 Zeichen.
    function isId(v) {
      return v is string && v.size() >= 1 && v.size() <= 150;
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Fehlendes Feld und null sind bei wahlfreien Feldern gleichwertig.
    function missing(d, key) {
      return !(key in d) || d[key] == null;
    }

    function optId(d, key) {
      return missing(d, key) || isId(d[key]);
    }

    function optInt(d, key, lo, hi) {
      return missing(d, key) || isInt(d[key], lo, hi);
    }

    function optDate(d, key) {
      return missing(d, key) || isDate(d[key]);
    }

    function optMillis(d, key) {
      return missing(d, key) || d[key] is int;
    }

    // Liste aus Kennungen. Ohne Schleifen lässt sich nicht jedes Element
    // einzeln prüfen. Deshalb: zu einer Zeichenkette verbinden und wieder
    // trennen. Nur wenn jedes Element eine Zeichenkette ohne Komma ist, kommt
    // dieselbe Liste heraus (aus der Zahl 7 würde der Text "7", aus null der
    // Text "null"; Maps und Listen brechen join() ab). Die Gesamtlänge
    // begrenzt zugleich die Länge der einzelnen Elemente.
    function isIdList(v) {
      return v is list
        && v.size() <= 500
        && (v.size() == 0
            || (v.join(',').size() <= v.size() * 151
                && v.join(',').split(',') == v
                && !('' in v)));
    }

    // Felder, die jedes abgeglichene Dokument trägt.
    function syncFields(d, docId) {
      return d.id == docId
        && isId(d.id)
        && d.updatedAt is int
        && d.deleted is bool
        && d.syncedAt == request.time;
    }

    // ---------- Sammlungen ----------

    function validMood(d, docId) {
      return hasExactly(d,
          ['id', 'level', 'name', 'icon', 'sortOrder', 'updatedAt', 'deleted', 'syncedAt'],
          ['archivedAt'])
        && syncFields(d, docId)
        && isInt(d.level, 1, 5)
        && isText(d.name, 0, 200)
        && isText(d.icon, 0, 100)
        && d.sortOrder is int
        && optMillis(d, 'archivedAt');
    }

    function validTagGroup(d, docId) {
      return hasExactly(d,
          ['id', 'name', 'colorIndex', 'sortOrder', 'collapsed', 'updatedAt', 'deleted', 'syncedAt'],
          ['archivedAt'])
        && syncFields(d, docId)
        && isText(d.name, 0, 200)
        && isInt(d.colorIndex, 0, 1000)
        && d.sortOrder is int
        && d.collapsed is bool
        && optMillis(d, 'archivedAt');
    }

    function validTag(d, docId) {
      return hasExactly(d,
          ['id', 'name', 'icon', 'sortOrder', 'updatedAt', 'deleted', 'syncedAt'],
          ['groupId', 'colorIndex', 'archivedAt'])
        && syncFields(d, docId)
        && optId(d, 'groupId')
        && isText(d.name, 0, 200)
        && isText(d.icon, 0, 100)
        && optInt(d, 'colorIndex', 0, 1000)
        && d.sortOrder is int
        && optMillis(d, 'archivedAt');
    }

    // Liste aus Maps: nur Typ und Länge, siehe Hinweis am Dateianfang.
    function isMapList(v, maxItems) {
      return v is list && v.size() <= maxItems;
    }

    function validScale(d, docId) {
      return hasExactly(d,
          ['id', 'type', 'name', 'icon', 'colorIndex', 'sortOrder', 'chartMode', 'trend',
           'min', 'max', 'step', 'points', 'updatedAt', 'deleted', 'syncedAt'],
          ['archivedAt'])
        && syncFields(d, docId)
        && d.type in ['NUMBER', 'TEXT', 'DURATION']
        && isText(d.name, 0, 200)
        && isText(d.icon, 0, 100)
        && isInt(d.colorIndex, 0, 1000)
        && d.sortOrder is int
        && d.chartMode in ['DAILY_AVERAGE', 'DAILY_SUM']
        && d.trend in ['HIGHER_IS_BETTER', 'LOWER_IS_BETTER', 'NEUTRAL']
        && d.min is int
        && d.max is int
        && d.step is int
        && isMapList(d.points, 100)
        && optMillis(d, 'archivedAt');
    }

    function validEntry(d, docId) {
      return hasExactly(d,
          ['id', 'timestamp', 'offsetMinutes', 'localDate', 'minuteOfDay', 'moodId', 'title',
           'note', 'favorite', 'source', 'tagIds', 'scaleValues', 'assetIds',
           'updatedAt', 'deleted', 'syncedAt'],
          [])
        && syncFields(d, docId)
        && d.timestamp is int
        && isInt(d.offsetMinutes, -1080, 1080)
        && isDate(d.localDate)
        && isInt(d.minuteOfDay, 0, 1439)
        && isId(d.moodId)
        && isText(d.title, 0, 500)
        && isText(d.note, 0, 100000)
        && d.favorite is bool
        && d.source in ['APP', 'IMPORT', 'MCP']
        && isIdList(d.tagIds)
        && isMapList(d.scaleValues, 200)
        && isIdList(d.assetIds);
    }

    function validAsset(d, docId) {
      return hasExactly(d,
          ['id', 'type', 'fileName', 'checksum', 'takenAt', 'sizeBytes', 'durationMs',
           'updatedAt', 'deleted', 'syncedAt'],
          [])
        && syncFields(d, docId)
        && d.type in ['PHOTO', 'AUDIO']
        && isText(d.fileName, 1, 300)
        && isText(d.checksum, 0, 200)
        && d.takenAt is int
        && d.sizeBytes is int && d.sizeBytes >= 0
        && d.durationMs is int && d.durationMs >= 0;
    }

    function validGoal(d, docId) {
      return hasExactly(d,
          ['id', 'name', 'icon', 'colorIndex', 'repeat', 'timesPerWeek', 'weekdays',
           'reminderText', 'startDate', 'note', 'sortOrder', 'updatedAt', 'deleted', 'syncedAt'],
          ['tagId', 'reminderMinuteOfDay', 'endDate', 'archivedAt'])
        && syncFields(d, docId)
        && isText(d.name, 0, 200)
        && optId(d, 'tagId')
        && isText(d.icon, 0, 100)
        && isInt(d.colorIndex, 0, 1000)
        && d.repeat in ['DAILY', 'TIMES_PER_WEEK', 'WEEKDAYS']
        && isInt(d.timesPerWeek, 1, 7)
        && d.weekdays is list
        && d.weekdays.size() <= 7
        && d.weekdays.hasOnly([1, 2, 3, 4, 5, 6, 7])
        && optInt(d, 'reminderMinuteOfDay', 0, 1439)
        && isText(d.reminderText, 0, 500)
        && isDate(d.startDate)
        && optDate(d, 'endDate')
        && isText(d.note, 0, 100000)
        && d.sortOrder is int
        && optMillis(d, 'archivedAt');
    }

    function validGoalCheck(d, docId) {
      return hasExactly(d,
          ['id', 'goalId', 'date', 'updatedAt', 'deleted', 'syncedAt'],
          [])
        && syncFields(d, docId)
        && isText(d.goalId, 1, 100)
        && isDate(d.date)
        && d.id == d.goalId + '|' + d.date;
    }

    function dayAt(l, i) {
      return l.size() <= i || isInt(l[i], 0, 366);
    }

    function validImportantDay(d, docId) {
      return hasExactly(d,
          ['id', 'name', 'date', 'category', 'note', 'yearly', 'remindOnDay',
           'remindDaysBefore', 'sortOrder', 'updatedAt', 'deleted', 'syncedAt'],
          ['assetId'])
        && syncFields(d, docId)
        && isText(d.name, 0, 200)
        && isDate(d.date)
        && isText(d.category, 0, 200)
        && isText(d.note, 0, 100000)
        && optId(d, 'assetId')
        && d.yearly is bool
        && d.remindOnDay is bool
        && d.remindDaysBefore is list
        && d.remindDaysBefore.size() <= 10
        && dayAt(d.remindDaysBefore, 0) && dayAt(d.remindDaysBefore, 1)
        && dayAt(d.remindDaysBefore, 2) && dayAt(d.remindDaysBefore, 3)
        && dayAt(d.remindDaysBefore, 4) && dayAt(d.remindDaysBefore, 5)
        && dayAt(d.remindDaysBefore, 6) && dayAt(d.remindDaysBefore, 7)
        && dayAt(d.remindDaysBefore, 8) && dayAt(d.remindDaysBefore, 9)
        && d.sortOrder is int;
    }

    function validTemplate(d, docId) {
      return hasExactly(d,
          ['id', 'title', 'body', 'sortOrder', 'updatedAt', 'deleted', 'syncedAt'],
          [])
        && syncFields(d, docId)
        && isText(d.title, 0, 500)
        && isText(d.body, 0, 100000)
        && d.sortOrder is int;
    }

    function validReminder(d, docId) {
      return hasExactly(d,
          ['id', 'minuteOfDay', 'text', 'active', 'updatedAt', 'deleted', 'syncedAt'],
          [])
        && syncFields(d, docId)
        && isInt(d.minuteOfDay, 0, 1439)
        && isText(d.text, 0, 500)
        && d.active is bool;
    }

    function colorAt(l, i) {
      return l.size() <= i || (l[i] is string && l[i].matches('^[0-9A-Fa-f]{8}$'));
    }

    function validSettings(d) {
      return hasExactly(d,
          ['weekStart', 'midnightRule', 'showQuote', 'showMemories', 'themeMode', 'moodScheme',
           'customMoodColors', 'fontChoice', 'reportNotifications', 'updatedAt', 'syncedAt'],
          [])
        && isInt(d.weekStart, 1, 7)
        && d.midnightRule in ['ASK', 'PREVIOUS_DAY', 'CURRENT_DAY']
        && d.showQuote is bool
        && d.showMemories is bool
        && d.themeMode in ['SYSTEM', 'LIGHT', 'DARK']
        && isText(d.moodScheme, 1, 50)
        && d.customMoodColors is list
        && (d.customMoodColors.size() == 0 || d.customMoodColors.size() == 5)
        && colorAt(d.customMoodColors, 0) && colorAt(d.customMoodColors, 1)
        && colorAt(d.customMoodColors, 2) && colorAt(d.customMoodColors, 3)
        && colorAt(d.customMoodColors, 4)
        && isText(d.fontChoice, 1, 50)
        && d.reportNotifications is bool
        && d.updatedAt is int
        && d.syncedAt == request.time;
    }

    // Profil: createdAt ist der Server-Zeitstempel des Anlegens und bleibt
    // danach unverändert. Die Einwilligung trägt einen Zeitstempel, der nicht
    // in der Zukunft liegen darf.
    function validProfile(d) {
      return hasExactly(d,
          ['createdAt'],
          ['consentDiaryAt', 'consentVersion', 'appVersion'])
        && d.createdAt is timestamp
        && (missing(d, 'consentDiaryAt')
            || (d.consentDiaryAt is timestamp && d.consentDiaryAt <= request.time))
        && (missing(d, 'consentVersion') || isText(d.consentVersion, 1, 50))
        && (missing(d, 'appVersion') || isText(d.appVersion, 1, 50));
    }

    // ---------- Pfade ----------

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid)
        && validProfile(incoming())
        && incoming().createdAt == request.time;
      allow update: if isOwner(uid)
        && validProfile(incoming())
        && incoming().createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);

      match /settings/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && docId == 'main' && validSettings(incoming());
      }

      match /moods/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validMood(incoming(), docId);
      }

      match /tag_groups/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTagGroup(incoming(), docId);
      }

      match /tags/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTag(incoming(), docId);
      }

      match /scales/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validScale(incoming(), docId);
      }

      match /entries/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validEntry(incoming(), docId);
      }

      match /assets/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validAsset(incoming(), docId);
      }

      match /goals/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validGoal(incoming(), docId);
      }

      match /goal_checks/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validGoalCheck(incoming(), docId);
      }

      match /important_days/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validImportantDay(incoming(), docId);
      }

      match /templates/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTemplate(incoming(), docId);
      }

      match /reminders/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validReminder(incoming(), docId);
      }
    }
  }
}
